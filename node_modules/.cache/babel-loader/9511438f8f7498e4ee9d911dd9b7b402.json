ark","_callee","res","wrap","_callee$","_context","prev","next","sent","code","console","log","stop","_this2","_callee2","_callee2$","_context2","userType","userId","_this3","_callee3","_callee3$","_context3","_this4","_callee4","_callee4$","_context4","_this5","_callee5","_callee5$","_context5","_this6","_callee6","myChart","option","combined","top5","_callee6$","_context6","$echarts","init","document","getElementById","title","text","xAxis","axisLabel","show","interval","formatter","value","spaceIndex","indexOf","zh","substring","en","enFormatted","length","split","join","yAxis","series","type","names","map","index","count","counts","sort","a","b","slice","item","setOption","_this7","_callee7","_callee7$","_context7","left","tooltip","trigger","radius","center","label","emphasis","itemStyle","shadowBlur","shadowOffsetX","shadowColor","getList","_this8","_callee8","_callee8$","_context8","listParm","records","total"],"sources":["src/views/dashboard/index.vue"],"sourcesContent":["<template>\n  <el-main>\n    <div id=\"title\">\n      數據統計\n    </div>\n    <hr>\n    <div style=\"display: flex\">\n      <div id=\"main2\" style=\"width: 350px; height: 300px; flex-grow: 1\"></div>\n      <div id=\"main1\" style=\"width: 550px; height: 300px; flex-grow: 2\"></div>\n    </div>\n\n    <!-- 管理員統計 -->\n    <el-row :gutter=\"20\" type=\"flex\" class=\"row-bg\" justify=\"center\" style=\"margin-bottom: 80px\">\n      <el-col :span=\"6\">\n        <div class=\"show-header\" style=\"background: rgb(0,191,255)\">\n          <div class=\"show-num\">{{ readerCount }}</div>\n          <div class=\"bottom-text\"> 會員總數</div>\n        </div>\n      </el-col>\n      <el-col :span=\"6\">\n        <div class=\"show-header\" style=\"background: rgb(100,149,237)\">\n          <div class=\"show-num\">{{ applyReader }}</div>\n          <div class=\"bottom-text\"> 會員待審核</div>\n        </div>\n      </el-col>\n      <el-col :span=\"6\">\n        <div class=\"show-header\" style=\"background: rgb(60,179,113)\">\n          <div class=\"show-num\">{{ borrowApplyCount }}</div>\n          <div class=\"bottom-text\"> 借書待審核</div>\n        </div>\n      </el-col>\n      <el-col :span=\"6\">\n        <div class=\"show-header\" style=\"background: rgb(237, 64, 20)\">\n          <div class=\"show-num\">{{ borrowReturnCount }}</div>\n          <div class=\"bottom-text\"> 到期待還書</div>\n        </div>\n      </el-col>\n    </el-row>\n    <el-card class=\"box-card\" style=\"margin-top: 30px\">\n      <div slot=\"header\" class=\"announcement\">\n        <span style=\"color: #000000; font-weight: 600\"> 公告</span>\n      </div>\n      <div v-for=\"o in noticeList\" :key=\"o.noticeId\" class=\"text item\">\n        <span style=\"font-weight:600;font-size:14px;\">{{ o.noticeTitle }}</span><span\n          style=\"margin-left:30px;font-size:14px\">{{ o.noticeContent }}</span>\n        <el-divider></el-divider>\n      </div>\n    </el-card>\n  </el-main>\n</template>\n\n<script>\nimport { getUserType, getUserId } from '@/utils/auth'\nimport { getReaderCountApi, getApplyReaderCountApi } from '@/api/reader'\nimport { getBorrowApplyCountApi, getBorrowReturnCountApi } from '@/api/borrow'\nimport { categoryCountApi } from '@/api/category'\nimport { getHotBookApi } from '@/api/book'\nimport { getTopListApi } from '@/api/notice'\nimport { getListApi } from '@/api/role'\n\nexport default {\n  name: 'Dashboard',\n  data() {\n    return {\n      readerCount: 0,\n      applyReader: 0,\n      borrowApplyCount: 0,\n      borrowReturnCount: 0,\n      noticeList: [],\n      roleType: '',\n      tableData: [],\n      // 角色id\n      roleId: ''\n    }\n  },\n  mounted() {\n    this.myechert1()\n    this.myechert2()\n    this.getReaderCount()\n    this.getApplyReaderCount()\n    this.getBorrowApplyCount()\n    this.getBorrowReturnCount()\n    this.getNoticeList()\n  },\n  methods: {\n    async getNoticeList() {\n      let res = await getTopListApi()\n      if (res && res.code == 200) {\n        console.log('公告')\n        console.log(res)\n        this.noticeList = res.data\n      }\n    },\n    async getBorrowReturnCount() {\n      let res = await getBorrowReturnCountApi({\n        userType: getUserType(),\n        userId: getUserId()\n      })\n      console.log(res)\n      if (res && res.code == 200) {\n        this.borrowReturnCount = res.data\n      }\n    },\n    async getBorrowApplyCount() {\n      let res = await getBorrowApplyCountApi({\n        userType: getUserType(),\n        userId: getUserId()\n      })\n      console.log(res)\n      if (res && res.code == 200) {\n        this.borrowApplyCount = res.data\n      }\n    },\n    async getReaderCount() {\n      let res = await getReaderCountApi()\n      console.log(res)\n      if (res && res.code == 200) {\n        this.readerCount = res.data\n      }\n    },\n    async getApplyReaderCount() {\n      let res = await getApplyReaderCountApi()\n      console.log(res)\n      if (res && res.code == 200) {\n        this.applyReader = res.data\n      }\n    },\n    async myechert1() {\n      // 基於準備好的dom，初始化echarts實例\n      var myChart = this.$echarts.init(document.getElementById('main1'))\n\n      // 指定圖表的配置項目和數據\n      var option = {\n        title: {\n          text: '書本分類統計'\n        },\n        xAxis: {\n          data: [],\n          axisLabel: {\n            show: true,\n            interval: 0,\n            formatter: function (value) {\n              // 用空格分開中文同英文部分\n              const spaceIndex = value.indexOf(' ')\n              if (spaceIndex === -1) {\n                // 冇空格,即係冇英文部分,直接顯示原文\n                return value\n              }\n              const zh = value.substring(0, spaceIndex)\n              const en = value.substring(spaceIndex + 1)\n              // 英文超過 6 個字母就每個字母分行,否則保持完整一行\n              const enFormatted = en.length > 6 ? en.split(' ').join('\\n') : en\n              return zh + '\\n' + enFormatted\n            }\n          }\n        },\n        yAxis: {},\n        series: [\n          {\n            name: '數量',\n            type: 'bar',\n            data: []\n          }\n        ]\n      }\n      // 動態取得數據\n      let res = await categoryCountApi()\n      if (res && res.code == 200) {\n        console.log('分類數據')\n        console.log(res)\n        const combined = res.data.names.map((name, index) => ({\n          name,\n          count: res.data.counts[index]\n        }))\n        const top5 = combined.sort((a, b) => b.count - a.count).slice(0, 5)\n        option.xAxis.data = top5.map(item => item.name)\n        option.series[0].data = top5.map(item => item.count)\n      }\n      // 使用剛指定的配置項和資料顯示圖表。\n      myChart.setOption(option)\n    },\n    async myechert2() {\n      // 基於準備好的dom，初始化echarts實例\n      var myChart = this.$echarts.init(document.getElementById('main2'))\n\n      // 指定圖表的配置項目和數據\n      var option = {\n        title: {\n          text: '熱門書本排行榜',\n          left: 'center'\n        },\n        tooltip: {\n          trigger: 'item'\n        },\n        series: [\n          {\n            name: '借閱次數',\n            type: 'pie',\n            radius: ['40%', '70%'],\n            center: ['50%', '50%'],\n            data: [],\n            label: {\n              show: true,\n              formatter: '{b}'\n            },\n            emphasis: { \n              itemStyle: {\n                shadowBlur: 10,\n                shadowOffsetX: 0,\n                shadowColor: 'rgba(0, 0, 0, 0.5)'\n              }\n            }\n          }\n        ]\n      }\n      // 動態獲取數據\n      let res = await getHotBookApi()\n      if (res && res.code == 200) {\n        console.log('熱門書本')\n        console.log(res)\n        option.series[0].data = res.data\n      }\n      // 使用剛指定的配置項和資料顯示圖表。\n      myChart.setOption(option)\n    },\n    // 獲取名單\n    async getList() {\n      const res = await getListApi(this.listParm)\n      if (res && res.code == 200) {\n        console.log(res)\n        // 設置表格數據\n        this.tableData = res.data.records\n        this.listParm.total = res.data.total\n      }\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.bottom-text {\n  bottom: 0;\n  width: 100%;\n  background: rgba(0, 0, 0, 0.1);\n  text-align: center;\n  position: absolute;\n  padding: 10px;\n}\n\n#title {\n  height: 50px;\n  font-size: 30px\n}\n\n.show-header {\n  background: #00c0ef;\n  color: #fff;\n  height: 200px;\n  border-radius: 5px;\n  position: relative;\n}\n\n.show-num {\n  font-size: 60px;\n  font-weight: 600;\n  padding: 40px 0 0 0;\n  text-align: center;\n}\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAoDA,SAAAA,WAAA,EAAAC,SAAA;AACA,SAAAC,iBAAA,EAAAC,sBAAA;AACA,SAAAC,sBAAA,EAAAC,uBAAA;AACA,SAAAC,gBAAA;AACA,SAAAC,aAAA;AACA,SAAAC,aAAA;AACA,SAAAC,UAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,WAAA;MACAC,WAAA;MACAC,gBAAA;MACAC,iBAAA;MACAC,UAAA;MACAC,QAAA;MACAC,SAAA;MACA;MACAC,MAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,SAAA;IACA,KAAAC,SAAA;IACA,KAAAC,cAAA;IACA,KAAAC,mBAAA;IACA,KAAAC,mBAAA;IACA,KAAAC,oBAAA;IACA,KAAAC,aAAA;EACA;EACAC,OAAA;IACAD,aAAA,WAAAA,cAAA;MAAA,IAAAE,KAAA;MAAA,OAAAC,iBAAA,cAAAC,mBAAA,GAAAC,IAAA,UAAAC,QAAA;QAAA,IAAAC,GAAA;QAAA,OAAAH,mBAAA,GAAAI,IAAA,UAAAC,SAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,IAAA,GAAAD,QAAA,CAAAE,IAAA;YAAA;cAAAF,QAAA,CAAAE,IAAA;cAAA,OACA/B,aAAA;YAAA;cAAA0B,GAAA,GAAAG,QAAA,CAAAG,IAAA;cACA,IAAAN,GAAA,IAAAA,GAAA,CAAAO,IAAA;gBACAC,OAAA,CAAAC,GAAA;gBACAD,OAAA,CAAAC,GAAA,CAAAT,GAAA;gBACAL,KAAA,CAAAb,UAAA,GAAAkB,GAAA,CAAAvB,IAAA;cACA;YAAA;YAAA;cAAA,OAAA0B,QAAA,CAAAO,IAAA;UAAA;QAAA,GAAAX,OAAA;MAAA;IACA;IACAP,oBAAA,WAAAA,qBAAA;MAAA,IAAAmB,MAAA;MAAA,OAAAf,iBAAA,cAAAC,mBAAA,GAAAC,IAAA,UAAAc,SAAA;QAAA,IAAAZ,GAAA;QAAA,OAAAH,mBAAA,GAAAI,IAAA,UAAAY,UAAAC,SAAA;UAAA,kBAAAA,SAAA,CAAAV,IAAA,GAAAU,SAAA,CAAAT,IAAA;YAAA;cAAAS,SAAA,CAAAT,IAAA;cAAA,OACAlC,uBAAA;gBACA4C,QAAA,EAAAjD,WAAA;gBACAkD,MAAA,EAAAjD,SAAA;cACA;YAAA;cAHAiC,GAAA,GAAAc,SAAA,CAAAR,IAAA;cAIAE,OAAA,CAAAC,GAAA,CAAAT,GAAA;cACA,IAAAA,GAAA,IAAAA,GAAA,CAAAO,IAAA;g